{
  "name": "quackie",
  "displayName": "Quackie",
  "description": "Rewrite your Git commit messages in the voice of 40 developer personas — dry seniors, sarcastic ducks, grim doomers, and more. Install once, pick a persona, commit as usual.",
  "version": "0.2.4",
  "publisher": "quackie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tearcompany/quackie.git"
  },
  "bugs": {
    "url": "https://github.com/tearcompany/quackie/issues"
  },
  "homepage": "https://quackie.me",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0a0a0f",
    "theme": "dark"
  },
  "keywords": [
    "git",
    "commit",
    "commit message",
    "conventional commits",
    "source control",
    "scm",
    "ai",
    "persona",
    "personality",
    "productivity"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Quackie rewrites commit messages locally or via the configured Quackie API. No workspace secrets are read."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quackie.selectPersona",
        "title": "Quackie: Select Persona"
      },
      {
        "command": "quackie.reloadPersonas",
        "title": "Quackie: Reload Personas"
      },
      {
        "command": "quackie.toggleAutoRewrite",
        "title": "Quackie: Toggle Auto Rewrite"
      },
      {
        "command": "quackie.rewriteNow",
        "title": "Quackie: Rewrite Now"
      },
      {
        "command": "quackie.commitWithPersona",
        "title": "Quackie: Commit with Persona",
        "icon": "$(sparkle)"
      }
    ],
    "keybindings": [
      {
        "command": "quackie.commitWithPersona",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "scmProvider == git"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "quackie.commitWithPersona",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Quackie",
      "properties": {
        "quackie.persona": {
          "type": "string",
          "default": "",
          "description": "Active persona id"
        },
        "quackie.autoRewrite": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rewrite commit messages as you type"
        },
        "quackie.debounceMs": {
          "type": "number",
          "default": 500,
          "minimum": 250,
          "description": "Debounce delay in milliseconds before rewriting"
        },
        "quackie.apiUrl": {
          "type": "string",
          "default": "https://quackie.me/api/rewrite",
          "description": "Quackie rewrite API endpoint"
        },
        "quackie.enabledTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "commit"
            ]
          },
          "default": [
            "commit"
          ],
          "description": "Rewrite targets enabled for the runtime (commit only in v0.2)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node scripts/sync-personas.js && npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "test": "npm run check-types && tsc -p tsconfig.test.json && node --test out-test/**/*.test.js",
    "watch": "node scripts/sync-personas.js && npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "package": "node scripts/sync-personas.js && npm run check-types && node esbuild.js --production",
    "sync-personas": "node scripts/sync-personas.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
